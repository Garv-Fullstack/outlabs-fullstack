datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RATE_LIMITED_DELAYED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  ENQUEUED
  FAILED
}

enum SlackStatus {
  ACTIVE
  DISCONNECTED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  googleId          String             @unique @map("google_id") @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  name              String             @db.VarChar(255)
  avatarUrl         String?            @map("avatar_url") @db.Text
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  senders           SenderAccount[]
  campaigns         EmailCampaign[]
  deliveries        EmailDelivery[]
  slackIntegration  SlackIntegration?
  rateLimitEvents   RateLimitEvent[]

  @@map("users")
}

model SenderAccount {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  email             String             @db.VarChar(255)
  name              String             @db.VarChar(255)
  smtpHost          String             @default("smtp.ethereal.email") @map("smtp_host") @db.VarChar(255)
  smtpPort          Int                @default(587) @map("smtp_port")
  smtpUser          String             @map("smtp_user") @db.VarChar(255)
  smtpPassEncrypted String             @map("smtp_pass_encrypted") @db.Text
  hourlyLimit       Int                @default(100) @map("hourly_limit")
  minDelaySeconds   Int                @default(2) @map("min_delay_seconds")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns         EmailCampaign[]
  deliveries        EmailDelivery[]
  rateLimitEvents   RateLimitEvent[]

  @@unique([userId, email], name: "uq_user_sender_email")
  @@map("sender_accounts")
}

model EmailCampaign {
  id                        String             @id @default(uuid()) @db.Uuid
  userId                    String             @map("user_id") @db.Uuid
  senderId                  String             @map("sender_id") @db.Uuid
  subject                   String             @db.VarChar(500)
  bodyText                  String             @map("body_text") @db.Text
  bodyHtml                  String?            @map("body_html") @db.Text
  totalRecipients           Int                @default(0) @map("total_recipients")
  scheduledStartTime        DateTime           @map("scheduled_start_time") @db.Timestamptz
  delayBetweenEmailsSeconds Int                @default(2) @map("delay_between_emails_seconds")
  hourlyLimit               Int                @default(100) @map("hourly_limit")
  idempotencyKey            String             @unique @map("idempotency_key") @db.VarChar(255)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender                    SenderAccount      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  deliveries                EmailDelivery[]

  @@index([userId, createdAt])
  @@map("email_campaigns")
}

model EmailDelivery {
  id                 String          @id @default(uuid()) @db.Uuid
  campaignId         String          @map("campaign_id") @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  senderId           String          @map("sender_id") @db.Uuid
  recipientEmail     String          @map("recipient_email") @db.VarChar(255)
  recipientName      String?         @map("recipient_name") @db.VarChar(255)
  idempotencyKey     String          @unique @map("idempotency_key") @db.VarChar(255)
  bullmqJobId        String?         @unique @map("bullmq_job_id") @db.VarChar(255)
  status             EmailStatus     @default(SCHEDULED)
  scheduledFor       DateTime        @map("scheduled_for") @db.Timestamptz
  sentAt             DateTime?       @map("sent_at") @db.Timestamptz
  failedAt           DateTime?       @map("failed_at") @db.Timestamptz
  errorMessage       String?         @map("error_message") @db.Text
  retryCount         Int             @default(0) @map("retry_count")
  etherealMessageId  String?         @map("ethereal_message_id") @db.VarChar(255)
  etherealPreviewUrl String?         @map("ethereal_preview_url") @db.Text
  indexedInEs        Boolean         @default(false) @map("indexed_in_es")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  campaign           EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             SenderAccount   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([userId, status])
  @@index([senderId, scheduledFor])
  @@index([campaignId])
  @@map("email_deliveries")
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.Uuid
  eventType    String       @map("event_type") @db.VarChar(100)
  payload      Json
  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0) @map("retry_count")
  errorMessage String?      @map("error_message") @db.Text
  lockedAt     DateTime?    @map("locked_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("outbox_events")
}

model SlackIntegration {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @unique @map("user_id") @db.Uuid
  slackTeamId        String      @map("slack_team_id") @db.VarChar(255)
  slackTeamName      String?     @map("slack_team_name") @db.VarChar(255)
  slackChannelId     String      @map("slack_channel_id") @db.VarChar(255)
  slackChannelName   String?     @map("slack_channel_name") @db.VarChar(255)
  accessTokenEnc     String      @map("access_token_enc") @db.Text
  incomingWebhookUrl String?     @map("incoming_webhook_url") @db.Text
  status             SlackStatus @default(ACTIVE)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_integrations")
}

model RateLimitEvent {
  id                String        @id @default(uuid()) @db.Uuid
  senderId          String        @map("sender_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  hourBucket        String        @map("hour_bucket") @db.VarChar(32)
  emailsDispatched  Int           @map("emails_dispatched")
  limitThreshold    Int           @map("limit_threshold")
  slackNotified     Boolean       @default(false) @map("slack_notified")
  triggeredAt       DateTime      @default(now()) @map("triggered_at") @db.Timestamptz

  sender            SenderAccount @relation(fields: [senderId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([senderId, hourBucket])
  @@map("rate_limit_events")
}
