# ==============================================================================
# REACHINBOX APPLICATION CONFIGURATION TEMPLATE (.env.example)
# Note: Do not commit actual secrets to version control. Copy to .env for local use.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Cryptography & Sessions (Must be >= 32 characters / 256 bits)
JWT_SECRET=super_secret_jwt_signing_key_reachinbox_development_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database (Primary ACID Store)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox_db?schema=public

# Redis Connection (BullMQ Broker & Distributed Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_TLS=false

# Worker & Delivery Defaults (Milestone 2+ preparation)
WORKER_CONCURRENCY=10
DEFAULT_HOURLY_LIMIT=100
DEFAULT_MIN_DELAY_SECONDS=2

# Ethereal Email SMTP Defaults (Milestone 2)
DEFAULT_SMTP_HOST=smtp.ethereal.email
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=

# Elasticsearch Connection (Milestone 3)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Google OAuth 2.0 Credentials (Milestone 3)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 Credentials (Milestone 3)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
